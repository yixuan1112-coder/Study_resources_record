# Copy to .env.local for local development.

# Random secret used to sign session cookies. Generate one with:
#   npx auth secret
AUTH_SECRET=

# From your GitHub OAuth App (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Needed for local `next start` / self-hosting. Vercel detects its own host,
# so you do NOT need to set this in the Vercel dashboard.
AUTH_TRUST_HOST=true

# Pins the OAuth callback to one origin. Set this in production when the site
# answers on more than one hostname — a Vercel project also serves per-deployment
# URLs, and arriving on one of those otherwise produces a redirect_uri that does
# not match the OAuth App, which GitHub rejects.
# AUTH_URL=https://your-app.vercel.app

# Optional. The repo created under each signed-in account to hold their files.
# VAULT_REPO=ntu-course-vault
# VAULT_BRANCH=main

# Optional. The code-execution sandbox behind the editor's Run button — see
# runner/README.md. Leave both unset and the Run button simply does not appear;
# nothing else about the editor changes.
# RUNNER_URL=https://run.example.com
# RUNNER_TOKEN=
